{
  "name": "scoring",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "es-toolkit": "^1.52.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-map-gl": "^8.1.3",
    "recharts": "^2.15.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.182.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/drei": "^10.7.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
